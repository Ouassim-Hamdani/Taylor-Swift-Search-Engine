<?xml version="1.0"?>
<rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
         xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
         xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
         xmlns:owl="http://www.w3.org/2002/07/owl#"
         xml:base="taylorswift_ontology.owl"
         xmlns="taylorswift_ontology.owl#">

<owl:Ontology rdf:about="taylorswift_ontology.owl"/>

<owl:ObjectProperty rdf:about="#belongsTo">
  <rdfs:domain rdf:resource="#Song"/>
  <rdfs:range rdf:resource="#Album"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#contains">
  <rdfs:domain rdf:resource="#Song"/>
  <rdfs:range rdf:resource="#Segment"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#expresses">
  <rdfs:domain rdf:resource="#Segment"/>
  <rdfs:range rdf:resource="#Emotion"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#dealsWith">
  <rdfs:domain rdf:resource="#Segment"/>
  <rdfs:range rdf:resource="#Theme"/>
</owl:ObjectProperty>

<owl:DatatypeProperty rdf:about="#title">
  <rdfs:domain rdf:resource="#Song"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#name">
  <rdfs:domain rdf:resource="#Album"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  <rdfs:domain rdf:resource="#Emotion"/>
  <rdfs:domain rdf:resource="#Theme"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#lyrics">
  <rdfs:domain rdf:resource="#Segment"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
</owl:DatatypeProperty>

<owl:Class rdf:about="#Song">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#Album">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#Segment">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#Emotion">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#Theme">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>


</rdf:RDF>
